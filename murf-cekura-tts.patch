+    async def test_the_context_limit_is_a_refusal_and_other_errors_are_failures(self):
+        from tts_bench.adapters.base import is_refusal
+        from tts_bench.adapters.murf import MurfAdapter
+
+        murf, _ = adapter(MurfAdapter, "falcon-2.1", "en-US-judith")
+        over = await murf.open_context("over")
+        murf._on_message({"error": "Too many active contexts", "error_code": "ACTIVE_CONTEXT_LIMIT_EXCEEDED",
+                          "fatal": True, "context_id": "over", "concurrency": {"region": "us-east-2", "limit": 6, "used": 6}})
+        assert over.done.is_set() and is_refusal(over.error)
+        broken = await murf.open_context("broken")
+        murf._on_message({"error": "Something failed", "error_code": "INTERNAL_ERROR", "fatal": True, "context_id": "broken"})
+        assert broken.error == "INTERNAL_ERROR: Something failed" and not is_refusal(broken.error)
