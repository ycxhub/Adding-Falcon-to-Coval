diff --git a/tts-bench/tts_bench/adapters/murf.py b/tts-bench/tts_bench/adapters/murf.py
new file mode 100644
index 0000000..14ad9a7
--- /dev/null
+++ b/tts-bench/tts_bench/adapters/murf.py
@@ -0,0 +1,125 @@
+"""Murf Falcon 2.1 over its streaming websocket, ``/v1/speech/stream-input``.
+
+Auth and the audio contract sit on the handshake query string (``api-key``,
+``model``, ``sample_rate``, ``channel_type=MONO``, ``format=PCM``). A
+``voice_config`` frame names the voice, locale and ``context_id`` before t0.
+Text goes in as JSON frames on that context; ``end: true`` flushes and the
+server answers with base64 PCM then ``final: true``. The socket stays open
+after ``final``, so the receive loop must break on the flag.
+
+The host is the US-East region, pinned rather than left to the global router,
+since the campaign runs from US East. ``predictive_chunking`` is ``lenient``,
+the setting Murf recommends for voice agents (option ``predictive_chunking``);
+it rides on the first text frame, as the API takes it beside ``text``.
+
+Audio is requested as raw PCM (s16le, no header). ``format=WAV`` would prefix
+the first chunk; a header that still arrives is stripped so the timeline holds
+samples only.
+
+There is no cancel. ``clear: true`` drops only sentences not yet in synthesis:
+the one in flight is still delivered (3.8 s of audio after a clear 300 ms into
+``long.prep``), with no acknowledgement and no ``final``. So cancel is a
+declared exclusion rather than a measured one.
+
+A context over the account's concurrency limit gets
+``ACTIVE_CONTEXT_LIMIT_EXCEEDED`` and the socket closes with 4029; that is the
+account refusing, so it is reported as a refusal.
+
+Reference: https://murf.ai/api/docs/api-reference/text-to-speech/stream-input
+"""
+
+from __future__ import annotations
+
+import base64
+from typing import Any, ClassVar
+from urllib.parse import urlencode
+
+from tts_bench.adapters._ws import WebSocketAdapter
+from tts_bench.adapters.base import AdapterError
+
+_RIFF = b"RIFF"
+_WAV_HEADER_BYTES = 44
+
+
+def pcm_from_chunk(chunk: bytes) -> bytes:
+    """Raw PCM from one chunk: a leading WAV header dropped, anything else passed through."""
+    if chunk.startswith(_RIFF) and len(chunk) > _WAV_HEADER_BYTES:
+        data = chunk.find(b"data")
+        return chunk[data + 8:] if data != -1 else chunk[_WAV_HEADER_BYTES:]
+    return chunk
+
+
+class MurfAdapter(WebSocketAdapter):
+    name: ClassVar[str] = "murf"
+    supports_cancel: ClassVar[bool] = False
+    native_rates: ClassVar[tuple[int, ...]] = (8000, 16000, 24000, 44100, 48000)
+    setup_excluded: ClassVar[str] = "TCP, TLS, websocket upgrade, voice_config frame"
+    base = "wss://us-east.api.murf.ai/v1/speech/stream-input"
+
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._active: str | None = None
+        self._traces: dict[str, str] = {}
+
+    @property
+    def url(self) -> str:  # type: ignore[override]
+        return f"{self.base}?" + urlencode({
+            "api-key": self.api_key,
+            "model": self.config.model,
+            "sample_rate": self.config.sample_rate,
+            "channel_type": "MONO",
+            "format": "PCM",
+        })
+
+    def _locale(self) -> str:
+        """The option, else the locale a voice id like ``en-US-judith`` carries, else the item's language."""
+        if locale := self.config.option("locale"):
+            return locale
+        parts = self.config.voice.split("-")
+        if len(parts) >= 3:
+            return f"{parts[0]}-{parts[1]}"
+        language = self.config.language or "en-US"
+        return "en-US" if language.lower() == "en" else language
+
+    def _context(self, context_id: str | None) -> str | None:
+        return context_id or self._active
+
+    async def _connect(self) -> None:
+        try:
+            await super()._connect()
+        except AdapterError as exc:
+            raise AdapterError(str(exc).replace(self.api_key, "<redacted>")) from exc.__cause__
+
+    async def _open_context(self, context_id: str) -> None:
+        self._active = context_id
+        await self._send_json({
+            "voice_config": {"voiceId": self.config.voice, "locale": self._locale()},
+            "context_id": context_id,
+        })
+
+    async def _send_text(self, context_id: str, text: str, first: bool) -> None:
+        payload: dict[str, Any] = {"text": text, "context_id": context_id, "end": False}
+        if first:
+            payload["predictive_chunking"] = self.config.option("predictive_chunking", "lenient")
+        await self._send_json(payload)
+
+    async def _finish(self, context_id: str) -> None:
+        await self._send_json({"text": "", "context_id": context_id, "end": True})
+
+    def _on_message(self, message: dict[str, Any]) -> None:
+        context_id = self._context(message.get("context_id"))
+        if context_id and message.get("trace_id"):
+            self._traces.setdefault(context_id, message["trace_id"])
+        error = message.get("error") or message.get("errorMessage")
+        if error:
+            code = message.get("error_code")
+            if code == "ACTIVE_CONTEXT_LIMIT_EXCEEDED":
+                error = f"concurrency limit exceeded {message.get('concurrency') or ''}: {error}"
+            self._on_error(context_id, f"{code}: {error}" if code else str(error))
+            return
+        audio = message.get("audio")
+        if audio and context_id:
+            self._on_audio(context_id, pcm_from_chunk(base64.b64decode(audio)))
+        if message.get("final") and context_id:
+            self._on_done(context_id, trace_id=message.get("trace_id") or self._traces.get(context_id),
+                          region=(message.get("concurrency") or {}).get("region"))
